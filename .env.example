# Ключ Anthropic API (обов'язково для чату/документів) — https://platform.claude.com/
ANTHROPIC_API_KEY=

# Модель Claude для чату та генерації документів
CLAUDE_MODEL=claude-sonnet-5
# Глибина міркувань моделі: low | medium | high. medium — баланс якості і
# швидкості (~20-30 с на відповідь чату).
CLAUDE_EFFORT=medium
# Ліміти токенів. У Sonnet 5 міркування (adaptive thinking) і текст відповіді
# ділять один бюджет max_tokens — занадто малий ліміт обриває відповідь.
MAX_ANSWER_TOKENS=8000
MAX_DOCUMENT_TOKENS=12000
CLAUDE_TIMEOUT_SECONDS=80

# Режим відповіді чату:
#   hybrid — частина «З бази знань» (з посиланнями [N]) + окремо позначена
#            частина «Загальні клінічні знання AI» для того, чого в базі немає;
#   strict — лише з бази знань; якщо фрагментів немає — «недостатньо даних».
ANSWER_MODE=hybrid

# Embedding-модель (будь-яка з sentence-transformers, що працює з українською)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Параметри RAG
# Скільки чанків іде в контекст Claude після злиття векторного і BM25-пошуку.
# Фрагменти одного розділу статті зливаються в один. 14 — заміри 2026-09 на
# базі з 38 статей (профільний розділ частіше потрапляє в контекст, ніж при 10).
RAG_TOP_K=14
# Максимальна косинусна відстань (1 - cos_sim), щоб чанк вважався релевантним.
# Каліброване для multilingual-e5-base: релевантні запити ~0.09-0.19, явно
# сторонні ~0.24+. Поріг відсіює лише грубо нерелевантне; тематичну межу
# травматології тримає системний промпт LLM. Підбирайте під свою модель/дані.
RAG_MAX_DISTANCE=0.22
